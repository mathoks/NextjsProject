generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters", "views"]
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model Account {
  id                String  @id @default(cuid())
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [id], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("account")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model User {
  id                 String               @id @default(cuid())
  name               String               @unique
  email              String               @unique
  emailVerified      DateTime?            @map("email_verified")
  image              String?
  password           String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  accounts           Account?
  postReplies        CommentReply?
  messagesRecieved   Message[]            @relation("reciever")
  messagesSent       Message[]            @relation("sender")
  notifications      Notification[]
  posts              Post[]
  postComments       PostReview?
  prod_reviews       prod_reviews[]
  sessions           Session[]
  store              Store?
  reviews            storeReview[]        @relation("reviewer")
  storeSubscriptions StoreSubscriptions[]
  subscriptions      Subscription?
  ticket             Ticket[]
  wishlist           WishList?

  @@map("user")
}

model Store {
  id                 String              @id @unique @default(cuid()) @db.VarChar(30)
  businessName       String              @map("business_name")
  phone              String?
  shopAddress        String?             @unique @map("shop_address")
  email              String?
  state              String
  country            String
  market             String
  about              String
  bizLogo            String?             @map("biz_logo")
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  branches           Branch[]
  product            Product[]
  storeOwner         User                @relation(fields: [id], references: [id], onDelete: Cascade)
  storeReviews       storeReview[]
  storeSubscriptions StoreSubscriptions?

  @@index([id, createdAt(sort: Desc)])
  @@map("store")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verificationtoken")
}

model Product {
  id           String            @id @default(cuid())
  storeId      String            @map("store_id")
  name         String
  description  String
  price        Float
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  availability Availability      @default(IN_STOCK)
  negotiable   OPTIONS
  rating       Float             @default(0)
  categoryId   Int
  post         PostProduct[]
  prod_reviews prod_reviews[]
  prodImage    ProdImage[]
  category     Category          @relation(fields: [categoryId], references: [id])
  store        Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  attribute    ProductAttribute?
  branch       ProductBranch[]
  wishlist     WishList?

  @@map("product")
}

model PostProduct {
  id        String  @id @default(cuid())
  postId    String
  productId String
  post      Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("postproduct")
}

model Branch {
  id            String          @id @default(cuid())
  storeId       String          @map("store_id")
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  state         String
  country       String
  market        String
  phone         String
  branchAddress String?         @map("branchaddress")
  branchName    String?         @map("branchname")
  store         Store           @relation(fields: [storeId], references: [id])
  products      ProductBranch[]

  @@map("branch")
}

model ProductBranch {
  id        String  @id @default(cuid())
  productId String
  branchId  String
  branch    Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, branchId])
  @@map("productbranch")
}

model ProdImage {
  id        String   @id @default(cuid())
  image     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  prodId    String
  product   Product  @relation(fields: [prodId], references: [id], onDelete: Cascade)

  @@map("prodimage")
}

model ProductAttribute {
  id        String   @id @unique @default(cuid())
  color     String?
  size      String?
  weight    Int?
  brand     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  status    Status?  @default(NEW)
  material  String?
  warranty  String?
  product   Product  @relation(fields: [id], references: [id], onDelete: Cascade)

  @@map("product_attribute")
}

model WishList {
  id        String   @id @default(cuid())
  userId    String   @unique @map("user_id")
  productId String   @map("product_id")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [id], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@map("wishlist")
}

model Message {
  id        String   @id @default(cuid())
  message   String
  userId    String   @map("user_id")
  senderId  String   @map("sender_id")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ticket    Ticket   @relation(fields: [id], references: [id], map: "message_ffk")
  recipient User     @relation("reciever", fields: [userId], references: [id], map: "message_sende_ffk")
  sender    User     @relation("sender", fields: [senderId], references: [id])

  @@map("message")
}

model Ticket {
  id       String   @id @default(cuid())
  userId   String   @map("user_Id")
  messages Message?
  user     User     @relation(fields: [userId], references: [id], map: "ticket_ffk")

  @@map("ticket")
}

model Post {
  id          String         @id @default(cuid())
  userId      String         @map("user_id")
  text        String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  author      User           @relation(fields: [userId], references: [id], map: "post_key_ff")
  postComment PostReview?
  categorys   PostCategory[]
  products    PostProduct[]

  @@map("post")
}

model Category {
  id           Int            @id @default(autoincrement())
  name         String         @unique
  posts        PostCategory[]
  prod_reviews prod_reviews[]
  products     Product[]

  @@map("category")
}

model PostCategory {
  id         String   @id @default(cuid())
  postId     String
  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  post       Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@map("postbranch")
}

model PostReview {
  id        String        @id @default(cuid())
  content   String        @map("post_comment")
  createdAt DateTime      @default(now())
  userId    String?       @unique @map("user_id")
  updatedAt DateTime      @updatedAt
  postReply CommentReply?
  post      Post          @relation(fields: [id], references: [id], map: "post_ffk_comm")
  user      User?         @relation(fields: [userId], references: [id])

  @@map("post_review")
}

model CommentReply {
  id        String     @id @default(cuid())
  text      String
  authorId  String     @unique @map("author_id")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  author    User       @relation(fields: [authorId], references: [id])
  Comment   PostReview @relation(fields: [id], references: [id])

  @@unique([authorId, id], name: "authorId_commentId_FK")
  @@map("comment_reply")
}

model storeReview {
  id           String      @id @unique @default(cuid())
  comment      String
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  review       Int         @default(0)
  storeOwnerId String      @map("store_owner_id")
  userId       String      @map("user_id")
  reply        StoreReply?
  store        Store       @relation(fields: [storeOwnerId], references: [id], map: "store_review_ffk")
  commenter    User        @relation("reviewer", fields: [userId], references: [id])

  @@map("store_review")
}

model StoreReply {
  id        String      @id @default(cuid())
  text      String
  userId    String      @map("user_id")
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  Comment   storeReview @relation(fields: [id], references: [id])

  @@map("store_reply")
}

model Subscription {
  id        String   @id @default(cuid())
  userId    String   @unique @map("user_id")
  plan      Plan     @default(FREE)
  status    Status   @default(NEW)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])

  @@map("subscription")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])

  @@map("notification")
}

model StoreSubscriptions {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  storeId   String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  store     Store    @relation(fields: [storeId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, storeId], name: "unique_store_subscription")
  @@map("store_subscription")
}

model prod_reviews {
  id          String    @default(dbgenerated("gen_random_uuid()"))
  comment     String?
  createdat   DateTime? @default(now()) @db.Timestamp(6)
  updatedat   DateTime? @updatedAt @db.Timestamp(6)
  review      Int
  category_id Int
  user_id     String
  prod_id     String
  category    Category  @relation(fields: [category_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "categorylist_ffk")
  product     Product   @relation(fields: [prod_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "commentproduct_ffk")
  user        User      @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "usercomm_ffks")
  reply       Reply?

  @@id([id, category_id], name: "reviewId", map: "prodreviews_pkey")
  @@unique([id, category_id, user_id], name: "reviewIds", map: "prod_reviews_id_key")
  @@unique([category_id, user_id, prod_id], name: "userReview", map: "unik_revies")
}

model Reply {
  id          String       @id @default(cuid())
  text        String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  category_id Int
  comenter_id String
  review_id   String
  reviewer_id String
  Review      prod_reviews @relation(fields: [review_id, category_id, comenter_id], references: [id, category_id, user_id])

  @@unique([review_id, category_id, comenter_id])
  @@map("reply")
}

view ratings_stats {
  prod_id        String   @unique
  total_reviews  Int?
  average_rating Decimal? @db.Decimal
  percentage_5   Decimal? @db.Decimal
  percentage_4   Decimal? @db.Decimal
  percentage_3   Decimal? @db.Decimal
  percentage_2   Decimal? @db.Decimal
  percentage_1   Decimal? @db.Decimal
}

enum OPTIONS {
  NEGOTIABLE
  BESTPRICE
}

enum Availability {
  IN_STOCK
  OUT_OF_STOCK
  COMING_SOON
  LIMITED_STOCK
}

enum Status {
  NEW
  FAIRLY_USED
  REFURBISHED
}

enum Plan {
  PAID
  FREE
}

enum Role {
  ADMIN
  USER
  STORE_OWNER
  MODERATOR
  GUEST
}

enum MessageTypeEnum {
  SENT
  RECEIVED
}
